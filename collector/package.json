{
  "name": "web-data-collector-collector",
  "version": "1.0.3",
  "description": "Webデータ収集ツールの収集部（TypeScript）",
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && node --test \"dist/test/*.test.js\"",
